{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Riyadh",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Peer ranges are a published contract; widen them by hand alongside a changeset.",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "groupName": "non-major dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "description": "Listed before the ecosystem groups so their groupName wins for matching packages."
    },
    {
      "description": "Plugins track Hey API's next snapshots (no stable release has the DSL we use), so follow the npm `next` tag; its packages move together and need review.",
      "groupName": "Hey API",
      "matchPackageNames": ["@hey-api/**"],
      "followTag": "next"
    },
    {
      "groupName": "TypeSpec",
      "matchPackageNames": ["@typespec/**"]
    },
    {
      "groupName": "AsyncAPI",
      "matchPackageNames": ["@asyncapi/**"]
    },
    {
      "groupName": "oRPC",
      "matchPackageNames": ["@orpc/**"]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Native example SDK toolchains (Go, Gradle, SwiftPM).",
      "groupName": "native examples",
      "matchManagers": ["gomod", "gradle", "gradle-wrapper", "swift"]
    }
  ]
}
