{
  "name": "@ir-kit/compiler-kotlin",
  "version": "0.1.1",
  "description": "Typed Kotlin AST + printer. Build Kotlin source with a TypeScript-compiler-style factory API and print ktlint-clean output. Zero runtime dependencies.",
  "keywords": [
    "codegen",
    "ast",
    "printer",
    "kotlin",
    "compiler"
  ],
  "homepage": "https://github.com/ahmedrowaihi/ir-kit/tree/main/packages/compilers/kotlin",
  "bugs": {
    "url": "https://github.com/ahmedrowaihi/ir-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ahmed Rowaihi",
    "email": "ahmedrowaihi@gmail.com"
  },
  "contributors": [
    {
      "name": "Hey API",
      "email": "lubos@heyapi.dev",
      "url": "https://heyapi.dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrowaihi/ir-kit.git",
    "directory": "packages/compilers/kotlin"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ir-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
