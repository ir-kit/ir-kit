{
  "name": "@ir-kit/openapi-ts-plugin-kit",
  "version": "0.1.0",
  "description": "Helpers shared by the ir-kit plugins for @hey-api/openapi-ts",
  "keywords": [
    "openapi",
    "openapi-ts",
    "hey-api",
    "plugin"
  ],
  "homepage": "https://github.com/ahmedrowaihi/ir-kit/tree/main/packages/openapi/plugins/kit",
  "bugs": {
    "url": "https://github.com/ahmedrowaihi/ir-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ahmed Rowaihi",
    "email": "ahmedrowaihi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrowaihi/ir-kit.git",
    "directory": "packages/openapi/plugins/kit"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@hey-api/shared": ">=0.5.0"
  },
  "devDependencies": {
    "@hey-api/shared": "catalog:",
    "@ir-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
