{
  "name": "@ir-kit/openapi-java",
  "version": "2.0.0",
  "description": "Generate idiomatic Java 17 (java.net.http + Jackson) client SDKs from an OpenAPI 3.x spec.",
  "keywords": [
    "openapi",
    "java",
    "jackson",
    "codegen",
    "sdk",
    "client"
  ],
  "homepage": "https://github.com/ahmedrowaihi/ir-kit/tree/main/packages/openapi/java",
  "bugs": {
    "url": "https://github.com/ahmedrowaihi/ir-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ahmed Rowaihi",
    "email": "ahmedrowaihi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrowaihi/ir-kit.git",
    "directory": "packages/openapi/java"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "runtime/*.java",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@hey-api/shared": "catalog:",
    "@hey-api/spec-types": "catalog:",
    "@ir-kit/openapi-tools": "workspace:*",
    "@ir-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@ir-kit/codegen-core": "workspace:*",
    "@ir-kit/compiler-java": "workspace:*",
    "@ir-kit/openapi": "workspace:*",
    "@ir-kit/openapi-loader": "workspace:*"
  },
  "peerDependencies": {
    "@hey-api/shared": "0.0.0-next-20260930190945",
    "@hey-api/spec-types": "0.0.0-next-20260930190945",
    "@ir-kit/openapi-tools": ">=0.5.0"
  }
}
