{
  "extends": "@ir-kit/tsconfig/lib.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "typescript": ["./node_modules/typescript5"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "runtime/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
