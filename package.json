{
  "name": "ir-kit",
  "private": true,
  "description": "Toolkit for OpenAPI / AsyncAPI / SDK contract codegen",
  "homepage": "https://github.com/ahmedrowaihi/ir-kit",
  "bugs": {
    "url": "https://github.com/ahmedrowaihi/ir-kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ahmed Rowaihi",
    "email": "ahmedrowaihi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrowaihi/ir-kit.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "pnpm -r --filter '!./examples/*' run build",
    "dev": "pnpm --filter @ir-kit/kit run dev",
    "typecheck": "pnpm -r --filter '!./examples/*' run typecheck",
    "test": "pnpm -r --filter '!./examples/*' run test",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "check:exports": "node scripts/check-exports.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.8",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  }
}
